#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

start_service() {
    local enabled listen server station root spool settings temp
    config_load meteo
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0
    config_get listen main listen
    config_get server main server
    config_get station main station meteo-1
    [ -n "$listen" ] && [ -n "$server" ] && [ -s /etc/meteo.token ] || return 1
    case "$station" in ''|*[!a-zA-Z0-9_-]*) return 1;; esac
    [ "${#station}" -le 32 ] || return 1
    case "$server" in http://*|https://*) ;; *) return 1;; esac

    root=/usr/lib/meteo-relay
    spool="/tmp/meteo-queue/$station"
    settings=/tmp/meteo-relay-config/settings.json
    mkdir -p "$spool" || return 1
    chmod 700 /tmp/meteo-queue "$spool" || return 1
    chown nobody /tmp/meteo-queue "$spool" || return 1
    mkdir -p /tmp/meteo-relay-config || return 1
    chmod 755 /tmp/meteo-relay-config || return 1
    . /usr/share/libubox/jshn.sh
    json_init
    json_add_string station "$station"
    json_add_string spool "$spool"
    json_add_string endpoint "${server%/}/v1/batches"
    json_add_string tokenFile /etc/meteo.token
    temp="$(mktemp /tmp/meteo-relay-config/settings.XXXXXX)" || return 1
    json_dump > "$temp" || return 1
    chmod 644 "$temp" || return 1
    mv "$temp" "$settings" || return 1

    procd_open_instance web
    procd_set_param command /usr/sbin/uhttpd -f -p "$listen" -h "$root/www" \
        -c /dev/null -x /v1 -S -D -n 4 -N 12 -t 8 -T 5 -k 0
    procd_set_param user nobody
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance forward
    procd_set_param command /bin/sh "$root/forward"
    procd_set_param user nobody
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger meteo
}
